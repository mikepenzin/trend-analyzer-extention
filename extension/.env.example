# URL of the Trend Analyzer backend.
# This value is baked into the extension bundle at build time (see scripts/build.mjs).
# Changing it requires a rebuild.
#
# Local development (default if .env is absent):
#   API_BASE_URL=http://localhost:8787
#
# Production (Vercel deployment):
#   API_BASE_URL=https://your-project.vercel.app
#
# Copy this file to .env and set the value for your environment.
API_BASE_URL=https://your-project.vercel.app
