{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": [
    "globals.d.ts",
    "background/**/*.ts",
    "content/**/*.ts",
    "sidepanel/**/*.ts",
    "types.ts"
  ]
}

